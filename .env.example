# Copy to .env. Never commit secrets or paste them into chat.
# Local development defaults to test mode. Production requires explicit live mode.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
# Run pnpm stripe:listen; it saves the local signing secret here privately.
STRIPE_WEBHOOK_SECRET=
APP_URL=http://localhost:3000
API_PORT=3001
DATABASE_PATH=./data/elysian.sqlite
# Set your own username and a password of at least 12 characters.
OWNER_USERNAME=
OWNER_PASSWORD=
# Production only: supplied by the connected Neon integration. Never prefix secrets with VITE_.
DATABASE_URL_UNPOOLED=
# Production only: permanent 32-byte random key encoded as base64. Back up privately.
HEALTH_DATA_KEY=

# Transactional email (Resend) and owner WhatsApp alerts (Twilio).
# Leave off until the sender domain, WhatsApp sender and template are approved.
# API secrets belong only on the server, never in VITE_ variables.
NOTIFICATIONS_ENABLED=false
NOTIFICATION_OWNER_EMAIL=elainecll@hotmail.com
NOTIFICATION_OWNER_WHATSAPP=+447707328060
NOTIFICATION_EMAIL_FROM=
RESEND_API_KEY=
# Resend delivery webhook signing secret, distinct from Stripe's webhook secret.
RESEND_WEBHOOK_SECRET=
# Published Resend template IDs or aliases (never API keys).
RESEND_REQUEST_TEMPLATE_ID=
RESEND_DEPOSIT_TEMPLATE_ID=
RESEND_CONFIRMATION_TEMPLATE_ID=
RESEND_OWNER_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Approved BUSINESS sender, not your personal receiving number.
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TEMPLATE_SID=
# Optional external scheduler: GET /api/notifications/retry with Bearer secret.
# Generate a random secret of at least 32 characters. Never put it in a URL.
NOTIFICATION_RETRY_SECRET=
