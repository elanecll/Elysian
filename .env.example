# Copy to .env. Never commit secrets or paste them into chat.
# Local development defaults to test mode. Production requires explicit live mode.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
# Run pnpm stripe:listen; it saves the local signing secret here privately.
STRIPE_WEBHOOK_SECRET=
APP_URL=http://localhost:3000
API_PORT=3001
DATABASE_PATH=./data/elysian.sqlite
# Set your own username and a password of at least 12 characters.
OWNER_USERNAME=
OWNER_PASSWORD=
# Production only: supplied by the connected Neon integration. Never prefix secrets with VITE_.
DATABASE_URL_UNPOOLED=
# Production only: permanent 32-byte random key encoded as base64. Back up privately.
HEALTH_DATA_KEY=
